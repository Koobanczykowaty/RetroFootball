{
  "name": "retro-football",
  "version": "0.3.0",
  "private": true,
  "description": "RetroFootball — A dynamic 2D pixel art arcade football game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sim": "node scripts/sim-test.mjs",
    "build:single": "tsc && vite build --mode single && node scripts/rename-single.mjs"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
